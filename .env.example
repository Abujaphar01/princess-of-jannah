# Facebook Page Access Configuration
# Get your Page ID and Page Access Token from https://developers.facebook.com/tools/explorer/
PAGE_ID=your_page_id_here
PAGE_ACCESS_TOKEN=your_page_access_token_here

# WhatsApp Group Configuration
WHATSAPP_ADMIN_GROUP_NAME=Princess of Jannah Posts
WHATSAPP_ADMIN_GROUP_ID=

# Scheduler Configuration (West Africa Time - Northern Nigeria UTC+1)
TIMEZONE=Africa/Lagos
POST_TIMES=06:30,13:30,20:30

# Short video duration bounds in seconds
MIN_REEL_DURATION_SEC=15
MAX_REEL_DURATION_SEC=120
